<?xml version="1.0" encoding="utf-8"?>
<!-- Round 140: compact Now Bar layout. The old version (title + 24dp
     slider + 36dp full-width button, ~107dp) was taller than the height
     Samsung gives this RemoteView on the lock screen: the button was
     clipped away entirely and the slider sat flush on the pill's bottom
     edge. This version is ~66dp: title row with a compact Tắt chip +
     one 20dp segmented bar. The shade's expanded notification keeps
     its own full-width button (see notification_flashlight_expanded). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flashlight_notification_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/flashlight_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFF5F7FA"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/flashlight_action_button"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_flashlight_action_button"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFF5F7FA"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/flashlight_segment_slot_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/flashlight_segment_1"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:src="@drawable/flashlight_segment_inactive" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/flashlight_segment_slot_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/flashlight_segment_2"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:src="@drawable/flashlight_segment_inactive" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/flashlight_segment_slot_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/flashlight_segment_3"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:src="@drawable/flashlight_segment_inactive" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/flashlight_segment_slot_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/flashlight_segment_4"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:src="@drawable/flashlight_segment_inactive" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/flashlight_segment_slot_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/flashlight_segment_5"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:src="@drawable/flashlight_segment_inactive" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/flashlight_disabled_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#33000000"
            android:text=""
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
