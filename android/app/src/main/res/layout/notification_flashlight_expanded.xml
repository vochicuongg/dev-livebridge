<?xml version="1.0" encoding="utf-8"?>
<!-- Round 140: the brightness control is now a 5-segment bar (was 5 dots
     floating in a grey track). Same slots, drawables and tap targets as
     the Now Bar view; the shade has room, so the full-width Tắt button
     and the warning line stay here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flashlight_notification_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/flashlight_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFF5F7FA"
        android:textSize="16sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/flashlight_segment_slot_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/flashlight_segment_1"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:src="@drawable/flashlight_segment_inactive" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/flashlight_segment_slot_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/flashlight_segment_2"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:src="@drawable/flashlight_segment_inactive" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/flashlight_segment_slot_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/flashlight_segment_3"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:src="@drawable/flashlight_segment_inactive" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/flashlight_segment_slot_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/flashlight_segment_4"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:src="@drawable/flashlight_segment_inactive" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/flashlight_segment_slot_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/flashlight_segment_5"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:src="@drawable/flashlight_segment_inactive" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/flashlight_disabled_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#33000000"
            android:text=""
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/flashlight_action_button"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_flashlight_action_button"
        android:gravity="center"
        android:textColor="#FFF5F7FA"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/flashlight_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FF6B7280"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
