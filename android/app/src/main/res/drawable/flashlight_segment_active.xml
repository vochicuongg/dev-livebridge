<?xml version="1.0" encoding="utf-8"?>
<!-- Round 140: a lit level is now a solid rounded bar (was a 16dp black
     dot with a blue ring, which read as a hole on the lock screen).
     No fixed size: the shape stretches to its ImageView slot. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#387AFF" />
    <corners android:radius="8dp" />
</shape>
